# vLLM image for the hybrid dense-bandwidth DFlash recipe (qwen3.5-122b-a10b-hybrid-dflash).
#
# Layered on the kvfix2 image rather than the AEON base, so everything that image already
# bakes (KV page-size unification, mamba prefix-align, blocktable fixes) is inherited rather
# than re-derived. On top go the three dense-bandwidth patches from
# github.com/Entrpi/qwen3.5-122B-A10B-on-spark -- the same lineage the kvfix patches came
# from -- which that repo applies from serve.sh at container start and we bake for the same
# reason as before: the launch should not depend on a wrapper script running first.
#
#   patch_inc_hybrid       FP8 dispatch for the hybrid checkpoint's dense layers (+8.8% there)
#   patch_int8_lmhead_v3   int8 w8a16 Triton GEMV lm-head (+33% on their bench)
#   patch_fla_shmem        FLA sm121 large-tile shared-memory tuning
#
# One patch of our own on top (dense2, 2026-08-24) — not from the Entrpi lineage but fixing a
# defect their unify+prefix-align combination exposes:
#
#   patch_mamba_chunk_align  align prefill chunks to the resolved LCM block size so mamba
#                            'align'-mode checkpoints land on true block boundaries; without it
#                            prefix-cache hits restore a stale GDN state and short prompts
#                            checkpoint nothing (specs/DREAMFERENCE_PREFIX_CACHE.md)
#   patch_unify_downscale    unify page sizes by scaling the drafter's block DOWN (2240 -> 1120)
#                            instead of everyone else up: LCM drops 4480 -> 2240, halving the
#                            prefix-cache hit floor/grid and doubling checkpoint density, and
#                            the mamba page's 2x padding waste disappears (dense3, spec §6.1)
#   patch_mamba_checkpoint_chunks  inside a dense region (DREAMFERENCE_CHECKPOINT_DENSE_BLOCKS,
#                            default 2 = first 4480 tokens) cap aligned prefill chunks at
#                            DREAMFERENCE_CHECKPOINT_CHUNK_BLOCKS blocks (default 1), so every
#                            2240 boundary there gets a mamba state checkpoint; deeper prefill
#                            runs full-budget chunks and the final boundary is always
#                            checkpointed. Uniform capping measured -14% prefill (dense4);
#                            the region form recovers it (dense5, spec §4.2)
#
# All are sentinel-guarded and fail loudly when their anchor is missing, so a base bump
# cannot silently produce an image that looks patched and is not.
#
# Keep this tag in sync with the `docker_image` entry in ModelMatrixRegistry.
FROM dreamference-vllm-dflash:0.23.0-aeon-kvfix2

COPY runtime/patch_inc_hybrid.py /opt/dreamference/patch_inc_hybrid.py
COPY runtime/patch_int8_lmhead_v3.py /opt/dreamference/patch_int8_lmhead_v3.py
COPY runtime/patch_fla_shmem.py /opt/dreamference/patch_fla_shmem.py
COPY runtime/patch_mamba_chunk_align.py /opt/dreamference/patch_mamba_chunk_align.py
COPY runtime/patch_unify_downscale.py /opt/dreamference/patch_unify_downscale.py
COPY runtime/patch_mamba_checkpoint_chunks.py /opt/dreamference/patch_mamba_checkpoint_chunks.py

RUN python3 /opt/dreamference/patch_inc_hybrid.py \
 && python3 /opt/dreamference/patch_int8_lmhead_v3.py \
 && python3 /opt/dreamference/patch_fla_shmem.py \
 && python3 /opt/dreamference/patch_mamba_chunk_align.py \
 && python3 /opt/dreamference/patch_unify_downscale.py \
 && python3 /opt/dreamference/patch_mamba_checkpoint_chunks.py
