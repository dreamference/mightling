{
  "comment": "The window's own preferences (DESKTOP_PARITY \u00a72.15: settings the CLI does not share). The desktop app's main process keeps them in prefs.json under its data folder (desktop/electron/src/prefs.ts) and refuses a key or a value this file does not describe; a browser keeps them in localStorage. Agent settings live in ~/.mightling/config.toml, written through config/value/write, never here.",
  "keys": {
    "enterBehaviour": {
      "default": "enter",
      "enum": [
        "enter",
        "ctrlEnter"
      ]
    },
    "followUp": {
      "default": "steer",
      "enum": [
        "steer",
        "queue"
      ]
    },
    "effort": {
      "default": null,
      "type": "string",
      "nullable": true
    },
    "recentModels": {
      "default": [],
      "type": "strings"
    },
    "editor": {
      "default": null,
      "type": "string",
      "nullable": true
    },
    "diffLayout": {
      "default": "unified",
      "enum": [
        "unified",
        "split"
      ]
    },
    "worktreeThreads": {
      "default": {},
      "type": "object"
    },
    "permanentWorktrees": {
      "default": [],
      "type": "strings"
    },
    "bottomPanel": {
      "default": false,
      "type": "boolean"
    },
    "fontScale": {
      "default": 1,
      "type": "number"
    },
    "keyOverrides": {
      "default": {},
      "type": "object"
    },
    "sidebarHidden": {
      "default": false,
      "type": "boolean"
    },
    "pinnedThreads": {
      "default": [],
      "type": "strings"
    },
    "pinnedProjects": {
      "default": [],
      "type": "strings"
    },
    "sections": {
      "default": [],
      "type": "list"
    },
    "unreadThreads": {
      "default": [],
      "type": "strings"
    },
    "recentsOpen": {
      "default": false,
      "type": "boolean"
    },
    "layout": {
      "default": "split",
      "enum": [
        "split",
        "tabs",
        "chat"
      ]
    },
    "preventSleep": {
      "default": true,
      "type": "boolean"
    },
    "notifyTurns": {
      "default": "unfocused",
      "enum": [
        "unfocused",
        "always",
        "never"
      ]
    },
    "notifyApprovals": {
      "default": true,
      "type": "boolean"
    },
    "appearance": {
      "default": {},
      "type": "object"
    },
    "branchPrefix": {
      "default": "mightling/",
      "type": "string"
    },
    "commitPrompt": {
      "default": null,
      "type": "string",
      "nullable": true
    },
    "forcePush": {
      "default": false,
      "type": "boolean"
    }
  }
}
