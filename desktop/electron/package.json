{
  "name": "mightling-desktop",
  "productName": "Mightling",
  "version": "1.5.1",
  "description": "Mightling's desktop app: Ask and Work in one window on its own ling app-server, with ling bundled inside (specs/DREAMFERENCE_MIGHTLING_DESKTOP_ELECTRON.md).",
  "author": "Dreamference",
  "license": "AGPL-3.0-or-later",
  "private": true,
