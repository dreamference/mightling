{
 "about": "The air-gap level's conformance cases (specs/DREAMFERENCE_MIGHTLING_AIRGAPPED.md §6.5). `resolve`: the tiers as read and what the resolver decides, run by this crate's tests. `answer`: what `ling airgapped --json` printed (`stdout` null: it could not be run; `timeout`: it did not finish) and the level a caller acts on, run by tests/test_airgapped.py and desktop/electron/src/airgapped.test.ts.",
 "resolve": [
  {
   "name": "nothing set is off",
   "configs": [],
   "expect": {
    "level": "off",
    "tier": "default",
    "notes": 0
   }
  },
  {
   "name": "a session file decides first",
   "session": {
    "text": "on\n"
   },
   "environment": "off",
   "configs": [
    {
     "path": "repo/dreamference.toml",
     "text": "mightling_airgapped = \"off\"\n"
    }
   ],
   "expect": {
    "level": "on",
    "tier": "session",
    "notes": 0
   }
  },
  {
   "name": "a session at off wins over an environment at on",
   "session": {
    "text": "off\n"
   },
   "environment": "on",
   "configs": [],
   "expect": {
    "level": "off",
    "tier": "session",
    "notes": 0
   }
  },
  {
   "name": "a session file that is not a level is on",
   "session": {
    "text": "duckduckgo\n"
   },
   "environment": "off",
   "configs": [],
   "expect": {
    "level": "on",
    "tier": "session",
    "notes": 1
   }
  },
  {
   "name": "an empty session file is on",
   "session": {
    "text": ""
   },
   "environment": "off",
   "configs": [],
   "expect": {
    "level": "on",
    "tier": "session",
    "notes": 1
   }
  },
  {
   "name": "a session file that cannot be read is on",
   "session": {
    "unreadable": "permission denied"
   },
   "environment": "off",
   "configs": [],
   "expect": {
    "level": "on",
    "tier": "session",
    "notes": 1
   }
  },
  {
   "name": "the environment decides before the files",
   "environment": " Off ",
   "configs": [
    {
     "path": "repo/dreamference.toml",
     "text": "mightling_airgapped = \"on\"\n"
    }
   ],
   "expect": {
    "level": "off",
    "tier": "environment",
    "notes": 0
   }
  },
  {
   "name": "an environment value that is not a level is on",
