     "text": "mightling_airgapped = \"on\"\n"
    }
   ],
   "expect": {
    "level": "on",
    "tier": "config",
    "path": "user/config.toml",
    "notes": 0
   }
  },
  {
   "name": "the repository's on beats the user's off",
   "configs": [
    {
     "path": "repo/dreamference.toml",
     "text": "mightling_airgapped = \"on\"\n"
    },
    {
     "path": "user/config.toml",
     "text": "mightling_airgapped = \"off\"\n"
    }
   ],
   "expect": {
    "level": "on",
    "tier": "config",
    "path": "repo/dreamference.toml",
    "notes": 0
   }
