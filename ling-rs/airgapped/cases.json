   "configs": [],
   "expect": {
    "level": "on",
    "tier": "environment",
    "notes": 1
   }
  },
  {
   "name": "an empty environment variable is not a tier",
   "environment": "",
   "configs": [
    {
     "path": "user/config.toml",
     "text": "mightling_airgapped = \"off\"\n"
    }
   ],
   "expect": {
    "level": "off",
    "tier": "config",
    "path": "user/config.toml",
    "notes": 0
   }
  },
