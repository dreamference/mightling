 ],
 "answer": [
  {
   "name": "off is off",
   "stdout": "{\"level\":\"off\",\"tier\":\"default\",\"source\":\"default\",\"invalid\":[]}\n",
   "status": 0,
   "expect": "off"
  },
  {
   "name": "on is on",
   "stdout": "{\"level\":\"on\",\"tier\":\"config\",\"source\":\"mightling_airgapped in user/config.toml\",\"invalid\":[]}\n",
   "status": 0,
   "expect": "on"
  },
  {
   "name": "notes do not change the level",
   "stdout": "{\"level\":\"off\",\"tier\":\"environment\",\"source\":\"DREAMFERENCE_MIGHTLING_AIRGAPPED\",\"invalid\":[\"a note\"]}\n",
   "status": 0,
   "expect": "off"
  },
  {
   "name": "no binary is on",
   "stdout": null,
   "status": null,
   "expect": "on"
  },
  {
   "name": "a timeout is on",
   "stdout": null,
   "status": null,
   "timeout": true,
   "expect": "on"
  },
  {
