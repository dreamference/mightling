#!/usr/bin/env python3
"""
Web search and page fetch for the agent, over the local SearXNG instance.

A shell command rather than an MCP tool, deliberately. The MCP servers are configured and their
tools do reach the model, but Codex exposes them only inside its `exec` JS runtime as
`tools.mcp__searxng__searxng_web_search(...)`, and this model does not reliably wrap calls that way
-- it tries to call the namespace directly, gets `unsupported call`, and falls back to guessing.
The shell it always has, and always uses correctly.

Nothing leaves this machine addressed to a search company: SearXNG queries the upstream engines on
its own and returns merged JSON. Output is trimmed because the raw response is ~25 KB, most of it
fields a model has no use for.

Usage:
    scripts/websearch "some query"          search, print title/url/snippet
    scripts/websearch --read <url>          fetch a page as readable text
    scripts/websearch -n 10 "some query"    more results (default 5)
"""

import argparse
import json
import os
import re
import sys
import urllib.error
import urllib.parse
import urllib.request

SEARXNG_URL = os.getenv("DREAMFERENCE_SEARXNG_URL", "http://127.0.0.1:8888")
USER_AGENT = (
    "Mozilla/5.0 (X11; Linux aarch64) AppleWebKit/537.36 (KHTML, like Gecko) "
    "Chrome/140.0 Safari/537.36"
)
TIMEOUT_S = 25
MAX_FETCH_BYTES = 5 * 1024 * 1024


def search(query: str, limit: int) -> int:
    """
    Prints search results as title / url / snippet triples.

    Args:
        query (str): Search terms.
        limit (int): Maximum results to print.

    Returns:
        int: Process exit status.
    """
    url = f"{SEARXNG_URL.rstrip('/')}/search?" + urllib.parse.urlencode(
        {"q": query, "format": "json", "language": "en"}
    )
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT_S) as response:
            payload = json.load(response)
    except (urllib.error.URLError, ValueError, OSError) as exc:
        print(f"search failed: SearXNG at {SEARXNG_URL} is unreachable ({exc})", file=sys.stderr)
        print(
            "start it with: docker start searxng   (or see runtime notes in CLAUDE.md)",
            file=sys.stderr,
        )
        return 1

    for answer in (payload.get("answers") or [])[:2]:
        print(f"ANSWER: {answer}\n")

    results = payload.get("results", [])[:limit]
    if not results:
        print("no results")
        return 0
    for index, result in enumerate(results, 1):
        snippet = " ".join((result.get("content") or "").split())[:200]
        print(f"{index}. {result.get('title','')}")
        print(f"   {result.get('url','')}")
        if snippet:
            print(f"   {snippet}")
    return 0


def read(url: str, max_chars: int) -> int:
    """
    Prints a URL's readable text with markup stripped.

    Args:
        url (str): Absolute http(s) URL.
        max_chars (int): Maximum characters to print.

    Returns:
        int: Process exit status.
    """
    if urllib.parse.urlparse(url).scheme not in ("http", "https"):
        print("only http and https URLs are supported", file=sys.stderr)
        return 1
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT, "Accept-Language": "en"})
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT_S) as response:
            raw = response.read(MAX_FETCH_BYTES)
            encoding = response.headers.get_content_charset() or "utf-8"
    except (urllib.error.URLError, OSError) as exc:
        print(f"fetch failed: {exc}", file=sys.stderr)
        return 1

    text = raw.decode(encoding, errors="replace")
    try:
        from bs4 import BeautifulSoup

        soup = BeautifulSoup(text, "html.parser")
        for tag in soup(("script", "style", "noscript", "svg", "iframe", "form")):
            tag.decompose()
        if soup.title:
            print(f"# {soup.title.get_text(strip=True)}\n")
        text = soup.get_text("\n")
    except ImportError:
        # bs4 is a dependency of this project, but the script stays useful without it.
        text = re.sub(r"<[^>]+>", " ", text)

    text = re.sub(r"[ \t]+", " ", text)
    text = re.sub(r"\n\s*\n\s*", "\n\n", text).strip()
    print(text[:max_chars])
    if len(text) > max_chars:
        print(f"\n[truncated at {max_chars} chars; rerun with --max-chars N for more]")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Search the web, or read a page, via local SearXNG.")
    parser.add_argument("query", nargs="*", help="Search terms")
    parser.add_argument("--read", metavar="URL", help="Fetch a URL and print readable text")
    parser.add_argument("-n", "--num-results", type=int, default=5, help="Results to show")
    parser.add_argument("--max-chars", type=int, default=8000, help="Characters to print for --read")
    args = parser.parse_args()

    if args.read:
        return read(args.read, args.max_chars)
    if not args.query:
        parser.print_help()
        return 2
    return search(" ".join(args.query), args.num_results)


if __name__ == "__main__":
    raise SystemExit(main())
