diff --git a/codex-rs/sandboxing/src/policy_transforms.rs b/codex-rs/sandboxing/src/policy_transforms.rs
--- a/codex-rs/sandboxing/src/policy_transforms.rs
+++ b/codex-rs/sandboxing/src/policy_transforms.rs
@@ -667,2 +667,8 @@ pub fn should_require_platform_sandbox(
 
+/// Whether commands under this profile run with no platform sandbox, so nothing could cut their network (Mightling's `/airgapped on` refuses it, like Full Access).
+pub fn runs_without_platform_sandbox(profile: &PermissionProfile) -> bool {
+    let (file_system_policy, network_policy) = profile.to_runtime_permissions();
+    !should_require_platform_sandbox(&file_system_policy, network_policy, /*has_managed_network_requirements*/ false)
+}
+
 #[cfg(test)]
diff --git a/codex-rs/sandboxing/src/policy_transforms_tests.rs b/codex-rs/sandboxing/src/policy_transforms_tests.rs
--- a/codex-rs/sandboxing/src/policy_transforms_tests.rs
+++ b/codex-rs/sandboxing/src/policy_transforms_tests.rs
@@ -1402 +1402,17 @@ fn effective_file_system_sandbox_policy_merges_additional_write_roots() {
 }
+
+#[test]
+fn a_profile_writing_the_whole_disk_with_the_network_on_runs_without_a_sandbox() {
+    use codex_protocol::models::PermissionProfile as SessionProfile;
+    let root_write = FileSystemSandboxPolicy::restricted(vec![FileSystemSandboxEntry {
+        path: FileSystemPath::Special { value: FileSystemSpecialPath::Root },
+        access: FileSystemAccessMode::Write,
+        missing_path_behavior: None,
+    }]);
+    let custom = |network| SessionProfile::from_runtime_permissions(&root_write, network);
+    assert_eq!(super::runs_without_platform_sandbox(&custom(NetworkSandboxPolicy::Enabled)), true);
+    assert_eq!(super::runs_without_platform_sandbox(&SessionProfile::Disabled), true);
+    assert_eq!(super::runs_without_platform_sandbox(&custom(NetworkSandboxPolicy::Restricted)), false);
+    assert_eq!(super::runs_without_platform_sandbox(&SessionProfile::workspace_write()), false);
+    assert_eq!(super::runs_without_platform_sandbox(&SessionProfile::read_only()), false);
+}
