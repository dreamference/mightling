+/// Mightling: no network when the command's session is air-gapped, so it runs as the offline account.
+pub(crate) fn mightling_airgapped(profile: &PermissionProfile, env_map: &HashMap<String, String>) -> PermissionProfile {
+    let mut profile = profile.clone();
+    if let PermissionProfile::Managed { network, .. } | PermissionProfile::External { network } = &mut profile && ling_airgapped::sealed_for_env(|key| env_map.get(key).cloned()) {
+        *network = NetworkSandboxPolicy::Restricted;
+    }
+    profile
+}
