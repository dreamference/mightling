+// Mightling: the caller's window station, not Winsta0: SSH runs in a service one.
+fn winsta(desktop: &str) -> Vec<u16> {
+    use windows_sys::Win32::System::StationsAndDesktops::*;
+    let mut name = [0u16; 256];
+    unsafe { GetUserObjectInformationW(GetProcessWindowStation(), UOI_NAME, name.as_mut_ptr().cast(), 512, &mut 0) };
+    let end = name.iter().position(|&c| c == 0).unwrap_or(0);
+    let station = if end > 0 { String::from_utf16_lossy(&name[..end]) } else { "Winsta0".into() };
+    to_wide(format!("{station}\\{desktop}"))
+}
