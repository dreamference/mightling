+
+#[test]
+fn airgapped_full_write_disk_keeps_bwrap_so_the_host_sockets_stay_denied() {
+    let socket = std::env::temp_dir().join("docker.sock");
+    let mut sealed = FileSystemSandboxPolicy::unrestricted();
+    seal_file_system(&mut sealed, /*on*/ true, vec![socket]);
+    assert!(!sealed.has_full_disk_write_access());
+    assert!(sealed.entries.iter().any(|entry| entry.access == codex_protocol::permissions::FileSystemAccessMode::Deny));
+
+    let mut open = FileSystemSandboxPolicy::unrestricted();
+    seal_file_system(&mut open, /*on*/ false, Vec::new());
+    assert_eq!(open, FileSystemSandboxPolicy::unrestricted());
+}
