diff --git a/codex-rs/core/tests/common/responses.rs b/codex-rs/core/tests/common/responses.rs
--- a/codex-rs/core/tests/common/responses.rs
+++ b/codex-rs/core/tests/common/responses.rs
@@ -458,3 +458,28 @@ pub fn namespace_child_tool<'a>(
 
-    None
+    flat_mcp_tool(tools, namespace, tool_name)
+}
+
+/// Mightling declares an MCP server's tools to the model as function tools (patch 0020,
+/// `ling_tools::flatten`): `<tool>`, or `<namespace>__<tool>` when that name is taken, with no
+/// namespace entry. The tool is found under that name; a plain name counts only if it is this
+/// namespace's (Codex flattened in this process), or, flattened in another process (the app
+/// server), by the name alone.
+fn flat_mcp_tool<'a>(tools: &'a [Value], namespace: &str, tool_name: &str) -> Option<&'a Value> {
+    if !namespace.starts_with("mcp__") {
+        return None;
+    }
+    let function = |name: &str| {
+        tools.iter().find(|tool| {
+            tool.get("type").and_then(Value::as_str) == Some("function")
+                && tool.get("name").and_then(Value::as_str) == Some(name)
+        })
+    };
+    if let Some(tool) = function(&format!("{namespace}__{tool_name}")) {
+        return Some(tool);
+    }
+    let tool = function(tool_name)?;
+    match ling_tools::resolve(None, tool_name.to_string()) {
+        (Some(owner), _) => (owner == namespace).then_some(tool),
+        (None, _) => Some(tool),
+    }
 }
